APP_ENV=prod
KIS_APP_KEY=replace_with_app_key
KIS_APP_SECRET=replace_with_app_secret
KIS_CANO=replace_with_account_number
KIS_ACNT_PRDT_CD=replace_with_product_code
# Optional multi-account mode. Keep the JSON on one line. Account credentials inherit
# KIS_APP_KEY and KIS_APP_SECRET unless both app_key and app_secret are provided.
# KIS_ACCOUNTS=[{"id":"general","label":"General","cano":"00000000","acnt_prdt_cd":"01"},{"id":"account_2","label":"Account 2","cano":"11111111","acnt_prdt_cd":"01","app_key":"replace_with_other_app_key","app_secret":"replace_with_other_app_secret"}]
KIS_BASE_URL=https://openapi.koreainvestment.com:9443

[Unit]
Description=Jusik prospective OOS boundary capture monitor only
After=default.target

[Service]
Type=exec
WorkingDirectory=%h/projects/jusik/backend
ExecStart=%h/projects/jusik/backend/.venv/bin/python -m jusik.research_boundary_monitor
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
Restart=on-failure
RestartSec=30s
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target

APP_ENV=dev
KIS_APP_KEY=replace_with_paper_app_key
KIS_APP_SECRET=replace_with_paper_app_secret
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
# KIS_WEBSOCKET_URL=ws://ops.koreainvestment.com:31000

# 선택 사항입니다. 두 값과 1 이상의 일일 예산이 모두 있을 때만 정기 연구 뒤 호출합니다.
# OPENAI_API_KEY=replace_with_api_key
# OPENAI_MODEL=replace_with_model
OPENAI_DAILY_TOKEN_BUDGET=0

# Optional point-in-time market research providers. Credentials alone do not
# mark historical coverage ready; verified membership, bars, actions and FX are required.
# KRX_AUTH_KEY=replace_with_krx_data_key
# MASSIVE_API_KEY=replace_with_massive_data_key
# MARKET_RESEARCH_DB_PATH=/path/to/market-research.db
# MARKET_RESEARCH_ARTIFACT_DIR=/path/to/market-research-artifacts
# Prepared bounded approximate response JSON only; web requests never backfill.
# APPROXIMATE_MARKET_DATA_PATH=/path/to/approximate-market-data.json
# CLI-only bounded network collector. Credentials are never written to cache or logs.
# ALPHA_VANTAGE_API_KEY=replace_with_alpha_vantage_key
# FRED_API_KEY=replace_with_fred_key
# MARKET_DATA_REQUEST_BUDGET=250
